{
  "name": "@ts-stg/thlib",
  "version": "0.1.0",
  "description": "Portable TypeScript Touhou-style STG gameplay library for TS-STG",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./touhou": {
      "types": "./dist/touhou/index.d.ts",
      "import": "./dist/touhou/index.js",
      "default": "./dist/touhou/index.js"
    },
    "./touhou/*": {
      "types": "./dist/touhou/*.d.ts",
      "import": "./dist/touhou/*.js",
      "default": "./dist/touhou/*.js"
    }
  },
  "files": [
    "src",
    "dist",
    "assets",
    "tsconfig.json",
    "tsconfig.base.json"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
