{
  "name": "ts-stg-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/thlib"
  ],
  "scripts": {
    "build": "npm run build:thlib && npm run build:examples && npm run build:editor-host",
    "build:thlib": "tsc -p packages/thlib/tsconfig.json",
    "build:examples": "tsc -p examples/tsconfig.json",
    "build:editor-host": "tsc -p tools/spellcard-editor/tsconfig.runtime.json",
    "typecheck": "tsc -p packages/thlib/tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit && tsc -p tools/spellcard-editor/tsconfig.runtime.json --noEmit",
    "typecheck:editor": "tsc -p tools/spellcard-editor/tsconfig.json --noEmit",
    "pretest": "npm run build",
    "editor": "npm --prefix tools/spellcard-editor start",
    "test": "node --test tests/*.test.js",
    "test:integration": "node tools/verify-integration.mjs",
    "test:backends": "node tools/verify-backends.mjs",
    "test:package": "node tools/verify-thlib-package.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "benchmark:native": "node tools/benchmark-native.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
