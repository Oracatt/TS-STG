{
  "name": "ts-stg-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ts-stg-workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/thlib",
        "games/touhou20",
        "games/rushboss"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "games/rushboss": {
      "name": "@ts-stg/rushboss-demo",
      "version": "0.1.0",
      "license": "GPL-3.0-only",
      "dependencies": {
        "@ts-stg/thlib": "0.1.0"
      }
    },
    "games/touhou20": {
      "name": "@ts-stg/touhou20-reference",
      "version": "0.1.0",
      "dependencies": {
        "@ts-stg/thlib": "0.1.0"
      }
    },
    "node_modules/@ts-stg/rushboss-demo": {
      "resolved": "games/rushboss",
      "link": true
    },
    "node_modules/@ts-stg/thlib": {
      "resolved": "packages/thlib",
      "link": true
    },
    "node_modules/@ts-stg/touhou20-reference": {
      "resolved": "games/touhou20",
      "link": true
    },
    "packages/thlib": {
      "name": "@ts-stg/thlib",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
